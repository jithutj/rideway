generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id        String      @id
  title     String
  location  String
  startsAt  DateTime    @db.Timestamptz(3)
  status    EventStatus @default(DRAFT)

  @@index([status, startsAt, id])
}
